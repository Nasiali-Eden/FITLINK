rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// FitLink Kenya — Firestore Security Rules
//
// Key business rule enforced here: the "NEW CLIENT LOCK".
// A referral doc id is `${clientId}_${providerId}`. It can be CREATED once and
// NEVER updated or deleted by non-admins. This permanently tags a client as a
// FitLink referral for that provider, so only the FIRST successful
// registration/booking can ever trigger the 1–2% commission.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function userCreateFields() {
      return request.resource.data.keys().hasOnly([
        'name', 'email', 'phone', 'role', 'registrationType', 'approved', 'createdAt', 'updatedAt'
      ]);
    }
    function userEditableFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'phone', 'photoURL', 'communicationPreferences', 'updatedAt'
      ]);
    }
    function providerOwnerEditableFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'county', 'town', 'location', 'specialty', 'category',
        'yearsExperience', 'certifications', 'pricePerHour', 'languages',
        'availability', 'bio', 'mapUrl', 'openingHours', 'services',
        'membershipFrom', 'registrationFrom', 'sessionFrom', 'photo', 'photos',
        'profilePhotoUrl', 'coverImageUrl', 'galleryImageUrls',
        'updatedAt'
      ]);
    }

    // ── Users ───────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && userCreateFields()
        && request.resource.data.role in ['client', 'provider']
        && ((request.resource.data.role == 'client' && request.resource.data.approved == true)
            || (request.resource.data.role == 'provider' && request.resource.data.approved == false)); // admins made manually
      allow update: if (isOwner(uid) && userEditableFields())
        || isAdmin();
      allow delete: if isAdmin();
    }

    // Provider applications are created and reviewed only by Cloud Functions.
    // Applicants can read their own application; no client can publish or
    // approve an application by writing Firestore directly.
    match /providerApplications/{applicationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Private, create-once M-Pesa idempotency locks. Only trusted backend code
    // may read or write transaction codes.
    match /mpesaPaymentProofs/{transactionCode} {
      allow read, write: if false;
    }

    // ── Providers (trainers, gyms, academies, wellness centres) ────────────
    match /providers/{providerId} {
      // Public can browse approved providers; owners/admin see everything.
      allow read: if resource.data.approved == true
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || isAdmin();
      // Creation is backend-only after a provider application is approved.
      allow create: if false;
      allow update: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid
            && providerOwnerEditableFields()
            && request.resource.data.status == resource.data.status
            && request.resource.data.approved == resource.data.approved
            && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ── Bookings ────────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (signedIn() && (resource.data.clientId == request.auth.uid
            || resource.data.providerOwnerUid == request.auth.uid));
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /bookingPaymentProofs/{transactionCode} {
      allow read, write: if false;
    }

    // ── Referrals — THE NEW CLIENT LOCK ────────────────────────────────────
    // Doc id MUST be `${clientId}_${providerId}`.
    // create-once, immutable, admin-only removal. This is what guarantees a
    // client can never be counted as "new" twice for the same provider.
    match /referrals/{referralId} {
      allow read: if isAdmin()
        || (signedIn() && (resource.data.clientId == request.auth.uid
            || resource.data.providerOwnerUid == request.auth.uid));
      allow create: if signedIn()
        && referralId == request.resource.data.clientId + '_' + request.resource.data.providerId
        && request.resource.data.locked == true;
      allow update: if false;   // immutable — nobody edits a referral tag
      allow delete: if isAdmin();
    }

    // ── Commissions ledger (1–2% of first registration/booking) ────────────
    // Written by trusted backend (Admin SDK bypasses rules). Clients never
    // write; providers can read their own entries.
    match /commissions/{commissionId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.providerOwnerUid == request.auth.uid);
      allow write: if false;    // Admin SDK / Cloud Functions only
    }

    // ── Public content ──────────────────────────────────────────────────────
    match /plans/{planId}          { allow read: if true; allow write: if isAdmin(); }
    match /blogPosts/{postId}      { allow read: if true; allow write: if isAdmin(); }
    match /successStories/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /settings/{settingId}    { allow read: if true; allow write: if isAdmin(); }

    // ── Everything else: deny ───────────────────────────────────────────────
    match /{document=**} { allow read, write: if false; }
  }
}
