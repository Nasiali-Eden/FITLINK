# FitLink — Firebase Web credentials (Project Settings → General → Your apps → Web app)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef
VITE_FITLINK_MPESA_NUMBER=0717 506 729
VITE_FITLINK_MPESA_NUMBER_E164=+254717506729

# Contentful Delivery API (optional). VITE_* values are public in the browser bundle.
# Use only a read-only Content Delivery API token here; never a Preview or Management token.
VITE_CONTENTFUL_SPACE_ID=your-space-id
VITE_CONTENTFUL_ENVIRONMENT=master
VITE_CONTENTFUL_DELIVERY_TOKEN=your-read-only-delivery-token
VITE_CONTENTFUL_LOCALE=en-US
